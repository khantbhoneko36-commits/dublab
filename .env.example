# Copy to .env and fill in your own keys. Never commit a real .env.

# Required: Gemini API key used for translation (free tier works).
GEMINI_API_KEY=

# Optional: comma-separated Gemini keys for TTS rotation.
# Falls back to GEMINI_API_KEY when empty.
GEMINI_TTS_API_KEYS=

# Optional: password for the /admin reviews page. Empty disables it.
DUBLAB_ADMIN_KEY=

# Optional: watermark text burned into dubbed videos.
DUBLAB_WATERMARK=made with DubLab
